{
  "name": "@hersy/eslint-config-expo",
  "version": "0.1.0",
  "description": "ESLint + Prettier config for Expo projects",
  "keywords": [
    "hersy",
    "eslint",
    "eslint-config",
    "exlint",
    "expo",
    "prettier",
    "react-native",
    "typescript"
  ],
  "homepage": "https://github.com/hersy/eslint-config-expo",
  "bugs": {
    "url": "https://github.com/hersy/eslint-config-expo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hersy/eslint-config-expo"
  },
  "license": "MIT",
  "author": "Hersy <me@hersy.dev>",
  "files": [
    "bin",
    "rules",
    "index.js",
    "prettier.config.js"
  ],
  "main": "index.js",
  "bin": {
    "exlint": "./bin/exlint.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "lint": "npx exlint --report-unused-disable-directives .",
    "pretests-only": "node ./test/requires",
    "pretest": "yarn --silent lint",
    "tests-only": "babel-tape-runner ./test/test-*.js",
    "test": "yarn --silent tests-only",
    "prepublish-only": "eslint-find-rules --unused && yarn test && safe-publish-latest",
    "prepublish": "not-in-publish || yarn prepublish-only"
  },
  "dependencies": {
    "eslint": "^9.24.0",
    "eslint-config-airbnb": "^19.0.0",
    "eslint-config-expo": "^8.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-import-name": "^1.2.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-perf": "^3.3.0",
    "eslint-plugin-unused-imports": "^4.1.0",
    "prettier": "^3.5.0",
    "prettier-eslint": "^16.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@hersy/babel-tape-runner": "^1.0.0",
    "@types/tape": "^5.8.0",
    "babel-preset-expo": "^12.0.0",
    "eslint-find-rules": "^5.0.0",
    "in-publish": "^2.0.0",
    "jest": "29.7.0",
    "safe-publish-latest": "^2.0.0",
    "tape": "^5.9.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "jest": "*",
    "react": "*"
  },
  "resolutions": {
    "@babel/plugin-proposal-class-properties": "yarn:@babel/plugin-transform-class-properties@^7.0.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "yarn:@babel/plugin-transform-nullish-coalescing-operator@^7.0.0",
    "@babel/plugin-proposal-optional-chaining": "yarn:@babel/plugin-transform-optional-chaining@^7.0.0",
    "@humanwhocodes/config-array": "yarn:@eslint/config-array@^0.17.0",
    "eslint": "^9.24.0",
    "glob": "^9.3.0",
    "rimraf": "^4.0.0"
  },
  "packageManager": "yarn@1.22.22"
}